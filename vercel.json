{
  "buildCommand": "pnpm --filter @workspace/magictrickguy build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/magictrickguy/dist/public",
  "framework": "vite",
  "redirects": [
    {
      "source": "/energy",
      "destination": "https://www.stefanoswald.com/Energy",
      "permanent": true
    },
    {
      "source": "/projects/energy",
      "destination": "https://www.stefanoswald.com/Energy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
